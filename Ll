		Node<Integer> a1 = new Node<>(2);
		Node<Integer> a2 = new Node<>(1);
		Node<Integer> a3 = new Node<>(2);
		Node<Integer> a4 = new Node<>(3);


		a1.setNext(a2);
		a2.setNext(a3);
		a3.setNext(a4);

		System.out.println(a1);
		//System.out.println(FindMin(a1));
		//System.out.println(q3_sortByMin(a1));
		//System.out.println(counter(a1, 5));
		//System.out.println(copy(a1));
		System.out.println(deleteExtra(a1));
	}
}
